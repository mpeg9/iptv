{
  "spider": "",
  "wallpaper": "",
  "sites": [
    {
      "key": "Config",
      "name": "配置中心",
      "type": 3,
      "api": "csp_Config",
      "searchable": 0,
      "changeable": 0
    }
  ],  
  "files": ["streams/*.m3u"],
  "rules": {
    "no-empty-lines": true,
    "require-header": true,
    "attribute-quotes": true,
    "require-info": true,
    "require-title": true,
    "no-trailing-spaces": false,
    "no-whitespace-before-title": true,
    "no-multi-spaces": true,
    "no-extra-comma": true,
    "space-before-paren": true,
    "no-dash": true,
    "require-link": true
  }
}
